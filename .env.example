NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEEPSEEK_API_KEY=

# Server-only (no NEXT_PUBLIC_ prefix). Used ONLY by the one-off script
# `npm run assign-food-images`, which resolves a real food photo for every
# food_database row and stores the URL + attribution on the row. The running
# app never reads this key and never calls Pexels at request/render time.
# Get a free key at https://www.pexels.com/api/ . Leave blank to skip image
# assignment (foods fall back to the deterministic emoji tile).
PEXELS_API_KEY=

# Server-only - never expose to the client (no NEXT_PUBLIC_ prefix). Used by
# lib/supabase/admin.ts for privileged operations (the notifications cron).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked by app/api/cron/notifications/route.ts (sent as
# `Authorization: Bearer <value>` by .github/workflows/notifications-cron.yml).
# The route fails closed if this is unset - no requests are authorized.
CRON_SECRET=

# Web Push (lib/notifications/push.ts). Generate a VAPID key pair (e.g. via
# `npx web-push generate-vapid-keys`) - the public key is safe to expose to
# the client, the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Server-only - never expose to the client (no NEXT_PUBLIC_ prefix). Read by
# Next.js itself (no application code references it); it is the salt for
# Server Action reference ids AND the closure-encryption key. Setting a fixed
# value here keeps those action ids STABLE across production builds, so a
# browser tab opened before a deploy can still invoke its Server Actions
# after the deploy instead of failing with
# `Server Action "<id>" was not found on the server.` (deployment skew).
# Leave BLANK locally - `next dev` generates its own ephemeral key.
#
# Vercel setup (do this once, in the dashboard - Project > Settings >
# Environment Variables):
#   - Name:  NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
#   - Value: a base64-encoded 32-byte random key, e.g.  openssl rand -base64 32
#   - Environments: Production, Preview, and Development (all three)
#   - Then redeploy so the build picks it up.
# Once set, NEVER rotate/overwrite it - changing it re-breaks every
# already-loaded client exactly like the skew it prevents.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
